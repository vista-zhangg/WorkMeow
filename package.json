{
  "name": "workmeow",
  "version": "1.8.4",
  "description": "Codex 喵伴（WorkMeow）：面向 Codex 的 Windows 桌宠与 AI 编程陪伴助手，提供状态提醒、订阅额度监控、token 用量统计和休息提醒，兼容 Claude Code、TRAE、WorkBuddy、opencode 与 ZCode。Codex desktop pet, companion and usage monitor.",
  "keywords": [
    "codex",
    "codex-desktop-pet",
    "codex-companion",
    "codex-usage-monitor",
    "desktop-pet",
    "ai-coding-assistant",
    "token-usage",
    "break-reminder",
    "windows",
    "claude-code",
    "trae",
    "workbuddy",
    "opencode",
    "zcode",
    "桌宠",
    "喵伴"
  ],
  "main": "main.js",
  "license": "MIT",
  "author": "vista-zhang",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vista-zhangg/codex-desktop-pet.git"
  },
  "homepage": "https://github.com/vista-zhangg/codex-desktop-pet#readme",
  "bugs": {
    "url": "https://github.com/vista-zhangg/codex-desktop-pet/issues"
  },
  "scripts": {
    "start": "node start-detached.js",
    "start:console": "electron .",
    "install:hooks": "node backend/hooks-cli.js",
    "uninstall:hooks": "node backend/hooks-cli.js --uninstall",
    "meter:rebuild": "node backend/meter-rebuild.js",
    "package:win": "electron-builder --win nsis --x64 --publish never && node scripts/finalize-dist.js",
    "verify:dist": "node scripts/verify-dist.js",
    "preview:ui": "node scripts/run-ui-preview.js",
    "test": "node test/run-all.js",
    "release:publish": "node scripts/publish-release.js"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "4.3.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "io.github.vista-zhangg.workmeow",
    "productName": "Codex 喵伴",
    "executableName": "WorkMeow",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "publish": [
      {
        "provider": "github",
        "owner": "vista-zhangg",
        "repo": "codex-desktop-pet",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "backend/**",
      "renderer/**",
      "assets/**",
      "shared/**",
      "hook/**",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/salary-cat.ico",
      "signExecutable": false,
      "artifactName": "WorkMeow-${version}-Windows-${arch}.${ext}",
      "electronLanguages": [
        "zh-CN"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    }
  }
}
